{
     "editor.codeActionsOnSave": {
          "source.fixAll": "never",
          "source.organizeImports": "explicit",
          "source.sortMembers": "explicit"
     },
     "css.lint.unknownAtRules": "ignore",
     "files.associations": {
          "*.css": "tailwindcss"
     },
     "editor.formatOnSave": false
}
